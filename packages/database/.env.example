# Pooled connection — used by Vercel serverless functions & the VPS bot at runtime.
DATABASE_URL="postgresql://user:password@your-vps-host:6432/if26_task_panel?pgbouncer=true"

# Direct connection — used only for `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://user:password@your-vps-host:5432/if26_task_panel"
